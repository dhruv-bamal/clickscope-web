{
  "name": "clickscope-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --import-plugin src",
    "typecheck": "tsc --noEmit",
